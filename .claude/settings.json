{
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(composer:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(vendor/bin/pint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./storage/credentials.json)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan db:wipe:*)"
    ]
  }
}
