# Modelo do .env.production da VM (docs/deploy.md). Copie para .env.production NA VM e preencha.
# O .env.production real está no .gitignore e no .dockerignore: nunca o versione.

APP_NAME=SisREAd
# Gere no seu computador com: php artisan key:generate --show
APP_KEY=
# O mesmo domínio de SERVER_NAME, com https://
APP_URL=https://sisread.eastus.cloudapp.azure.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_LEVEL=info

# Domínio onde o Caddy atende e emite o certificado HTTPS (sem https://)
SERVER_NAME=sisread.eastus.cloudapp.azure.com

# LLM: Groq (console.groq.com/keys, plano gratuito sem cartão). Ver docs/integracoes.md.
LLM_PROVEDOR=groq
GROQ_API_KEY=

# Experimento (docs/feature-flags.md): os códigos dos links de cada grupo. Os padrões
# (controle, transparencia, escrutabilidade) são fáceis de adivinhar; troque se quiser.
# EXPERIMENTO_CODIGO_CONTROLE=
# EXPERIMENTO_CODIGO_TRANSPARENCIA=
# EXPERIMENTO_CODIGO_ESCRUTABILIDADE=
